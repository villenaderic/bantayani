# Application
APP_NAME=BantayAni
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
DEMO_MODE=true

# Database
POSTGRES_USER=bantayani
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=bantayani
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bantayani:replace-with-a-strong-password@postgres:5432/bantayani

# Redis / job queue
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_MINUTES=60

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Frontend, picked up by the web container via docker compose env_file
VITE_API_BASE_URL=http://localhost:8000/api

# Satellite imagery provider: "demo" (default, synthetic data, always
# works with no credentials) or "copernicus" (real Sentinel-2 imagery
# via the free Copernicus Data Space Ecosystem). Get an OAuth client id
# and secret from your Copernicus Data Space Ecosystem dashboard, under
# User Settings, no cost, no operational use licensing restriction.
IMAGERY_PROVIDER=demo
COPERNICUS_CLIENT_ID=your-copernicus-oauth-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-oauth-client-secret

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=bantayani-media
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# Notifications
NOTIFICATIONS_EMAIL_FROM=alerts@yourdomain.gov.ph
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Application
APP_NAME=BantayAni
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-string
DEMO_MODE=true

# Database
POSTGRES_USER=bantayani
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=bantayani
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bantayani:replace-with-a-strong-password@postgres:5432/bantayani

# Redis / job queue
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN_MINUTES=60

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google Earth Engine (leave blank while DEMO_MODE=true)
EARTH_ENGINE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EARTH_ENGINE_PRIVATE_KEY_PATH=/run/secrets/earth-engine-key.json

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=bantayani-media
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key

# Notifications
NOTIFICATIONS_EMAIL_FROM=alerts@yourdomain.gov.ph
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
